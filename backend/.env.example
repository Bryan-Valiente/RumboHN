RUMBO_APP_ENV=<development-or-production>
RUMBO_DEBUG=false
RUMBO_ALLOWED_ORIGIN=<https-origin-serving-the-rumbo-client>
RUMBO_BASE_PATH=<optional-subdirectory-such-as-/demos/rumbo-hn>
RUMBO_SECURITY_PEPPER=<at-least-32-random-bytes-set-outside-git>

# Authentication remains closed until each production gate is verified.
RUMBO_LOGIN_ENABLED=false
RUMBO_REGISTRATION_ENABLED=false
# email_verification requires a verified delivery gate; admin_approval is for a controlled laboratory only.
RUMBO_REGISTRATION_MODE=email_verification
RUMBO_ACCOUNT_VERIFICATION_READY=false
RUMBO_PASSWORD_RECOVERY_ENABLED=false
RUMBO_COOKIE_SECURE=true
RUMBO_SESSION_TTL_SECONDS=604800
RUMBO_PASSWORD_RESET_TTL_SECONDS=1800
RUMBO_LOGIN_ATTEMPT_WINDOW_SECONDS=900
RUMBO_LOGIN_MAX_ATTEMPTS=5

RUMBO_DB_HOST=<rumbo-database-host>
RUMBO_DB_PORT=3306
RUMBO_DB_NAME=<exact-rumbo-database-name>
RUMBO_DB_ALLOWED_NAME=<same-exact-rumbo-database-name>
RUMBO_DB_USER=<dedicated-rumbo-database-user>
RUMBO_DB_PASSWORD=<set-outside-git>
