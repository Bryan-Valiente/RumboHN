RUMBO_APP_ENV=<development-or-production>
RUMBO_DEBUG=false
RUMBO_ALLOWED_ORIGIN=<https-origin-serving-the-rumbo-client>

RUMBO_DB_HOST=<rumbo-database-host>
RUMBO_DB_PORT=3306
RUMBO_DB_NAME=<exact-rumbo-database-name>
RUMBO_DB_ALLOWED_NAME=<same-exact-rumbo-database-name>
RUMBO_DB_USER=<dedicated-rumbo-database-user>
RUMBO_DB_PASSWORD=<set-outside-git>

RUMBO_SESSION_TTL_SECONDS=604800
